<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="StatusCast_Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="StatusCast"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- Ambient gradient background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1020" Offset="0" />
                <GradientStop Color="#111B2E" Offset="0.5" />
                <GradientStop Color="#070B14" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="StatusCast">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid
                MaxWidth="1360"
                Padding="40,22,40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        Text="StatusCast"
                        FontSize="26"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="iPhone + Android · Windows bridge"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Border
                        Padding="10,4"
                        Background="#1FFFFFFF"
                        CornerRadius="12">
                        <TextBlock
                            Text="v3.0.0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border
                        Padding="10,4"
                        Background="#1822D3EE"
                        CornerRadius="12">
                        <TextBlock
                            Text="LOCAL API"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#7DD3FC" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Main card -->
            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Width="1360"
                    Padding="40,18,40,24"
                    Spacing="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Border
                        Padding="44"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="30">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E61A2233" Offset="0" />
                                <GradientStop Color="#E6101624" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid ColumnSpacing="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>

                            <!-- Battery arc -->
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <Grid
                                    Width="260"
                                    Height="260"
                                    HorizontalAlignment="Center">
                                    <Ellipse
                                        Width="216"
                                        Height="216"
                                        Stroke="#1FFFFFFF"
                                        StrokeThickness="12" />

                                    <!-- Glow layer -->
                                    <Path
                                        Opacity="0.9"
                                        Stroke="{x:Bind ViewModel.BatteryArcGlowBrush, Mode=OneWay}"
                                        StrokeThickness="28"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="130,22" IsClosed="False">
                                                    <ArcSegment
                                                        Point="{x:Bind ViewModel.BatteryArcEndPoint, Mode=OneWay}"
                                                        Size="108,108"
                                                        SweepDirection="Clockwise"
                                                        IsLargeArc="{x:Bind ViewModel.BatteryArcIsLarge, Mode=OneWay}" />
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>

                                    <!-- Main arc -->
                                    <Path
                                        Stroke="{x:Bind ViewModel.BatteryArcBrush, Mode=OneWay}"
                                        StrokeThickness="12"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathFigure StartPoint="130,22" IsClosed="False">
                                                    <ArcSegment
                                                        Point="{x:Bind ViewModel.BatteryArcEndPoint, Mode=OneWay}"
                                                        Size="108,108"
                                                        SweepDirection="Clockwise"
                                                        IsLargeArc="{x:Bind ViewModel.BatteryArcIsLarge, Mode=OneWay}" />
                                                </PathFigure>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="1">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.BatteryLevelText, Mode=OneWay}"
                                            FontSize="62"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="%"
                                            Margin="0,0,0,12"
                                            VerticalAlignment="Bottom"
                                            FontSize="20"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Text="BATTERY"
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="180"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <!-- Details -->
                            <StackPanel
                                Grid.Column="1"
                                Spacing="16"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border
                                        Width="42"
                                        Height="42"
                                        VerticalAlignment="Center"
                                        Background="#1F22D3EE"
                                        CornerRadius="12">
                                        <TextBlock
                                            Text="📱"
                                            FontSize="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ModelDisplay, Mode=OneWay}"
                                        FontSize="38"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind ViewModel.BatteryDisplay, Mode=OneWay}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Rectangle
                                    Height="1"
                                    Margin="0,4"
                                    Fill="#22FFFFFF" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="56"
                                        Height="56"
                                        Background="#1F22D3EE"
                                        CornerRadius="16">
                                        <TextBlock
                                            Text="🎵"
                                            FontSize="26"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="MusicIconRotate" CenterX="13" CenterY="13" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.MediaTitleDisplay, Mode=OneWay}"
                                            FontSize="23"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.MediaArtistDisplay, Mode=OneWay}"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Border
                                        Padding="11,5"
                                        Background="#1FFFFFFF"
                                        CornerRadius="12">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.StateDisplay, Mode=OneWay}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border
                                        Padding="11,5"
                                        Background="#1822D3EE"
                                        CornerRadius="12">
                                        <TextBlock
                                            Text="HTTP · 5099"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#7DD3FC" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right-side live summary -->
                            <Border
                                Grid.Column="2"
                                Padding="24,0,0,0"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1,0,0,0"
                                VerticalAlignment="Center">
                                <StackPanel Spacing="20">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Text="REFRESH"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            CharacterSpacing="140"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="30s" FontSize="26" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Text="SOURCE"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            CharacterSpacing="140"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="USB" FontSize="24" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="LOCAL API"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            CharacterSpacing="140"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse
                                                x:Name="ApiDotMain"
                                                Width="7"
                                                Height="7"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock
                                                x:Name="ApiStatusMainText"
                                                Text="LIVE"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#7DD3FC" />
                                        </StackPanel>
                                        <TextBlock Text="PORT 5099" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Secondary device: Android -->
                    <Border
                        Padding="26,18"
                        Background="#CC111827"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="{x:Bind ViewModel.HasAndroid, Mode=OneWay}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Background="#1F34D399"
                                    CornerRadius="11">
                                    <TextBlock
                                        Text="🤖"
                                        FontSize="19"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.AndroidModelDisplay, Mode=OneWay}"
                                        FontSize="17"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.AndroidAppDisplay, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="18"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.AndroidBatteryDisplay, Mode=OneWay}"
                                    FontSize="13"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.AndroidMediaDisplay, Mode=OneWay}"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.AndroidStateDisplay, Mode=OneWay}"
                                    FontSize="10"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom status bar -->
        <Border
            Grid.Row="2"
            Padding="18,9"
            Background="#B30B1020"
            BorderBrush="#22FFFFFF"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="1360" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="{x:Bind ViewModel.ModelDisplay, Mode=OneWay}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.BatteryDisplay, Mode=OneWay}"
                    FontSize="12"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.MediaDisplay, Mode=OneWay}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <Border
                    Grid.Column="3"
                    Padding="10,4"
                    Background="#1FFFFFFF"
                    CornerRadius="11">
                    <TextBlock
                        Text="{x:Bind ViewModel.StateDisplay, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>

                <Border
                    Grid.Column="4"
                    Padding="10,4"
                    Background="#1822D3EE"
                    CornerRadius="11">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            x:Name="ApiDot"
                            Width="7"
                            Height="7"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            x:Name="ApiStatusText"
                            Text="API: 启动中"
                            FontSize="11"
                            Foreground="#7DD3FC" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
